@LIN:L1c:0.2
@CPMM_ORACLE{
  standard="LIN-CPMM-DETERMINISTIC-ORACLE"
  purpose="attested_cpmm_constant_product_swap_verification"
  properties="heapless_stack_only_zero_reentrancy"
}

// Compute swap output using Uniswap V2 constant product formula with 0.3% fee:
// dy = (reserve_out * dx * 997) / (reserve_in * 1000 + dx * 997)
!cpmm_get_amount_out(dx: int, reserve_in: int, reserve_out: int) -> int {
  ?(dx <= 0) {
    ^ 0;
  };
  ?(reserve_in <= 0) {
    ^ 0;
  };
  ?(reserve_out <= 0) {
    ^ 0;
  };

  dx_with_fee = dx * 997;
  numerator = reserve_out * dx_with_fee;
  denominator = (reserve_in * 1000) + dx_with_fee;
  ^ (numerator / denominator);
}

!verify_invariants(prev_k: int, new_k: int) -> int {
  ?(new_k >= prev_k) {
    ^ 1; // Valid state transition
  };
  ^ 0; // Fraud detected
}

=ex{cpmm_get_amount_out, verify_invariants}
