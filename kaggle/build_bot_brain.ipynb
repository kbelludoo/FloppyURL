 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🧠 Go Bot Knowledge Brain Generator (~100 MB Dense Vector Index)\n",
    "Este notebook roda no **Kaggle com GPU T4 (Grátis)** para processar o conhecimento especializado de bots em Go, gerar os embeddings neurais de 384 dimensões e exportar o binário `knowledge_brain.bin` para o **Agent Go** na VPS."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q sentence-transformers\n",
    "print('✅ Dependências instaladas!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import struct\n",
    "from pathlib import Path\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "print('🤖 Carregando modelo neural MiniLM (384-dim)...')\n",
    "model = SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')\n",
    "dim = model.get_sentence_embedding_dimension()\n",
    "print(f'Dimensão vetorial: {dim}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset Base: Especialidades de Bots em Go, Concorrência, VPS e Jogos\n",
    "KNOWLEDGE_SEEDS = [\n",
    "    {\n",
    "        'id': 'go_bot_goroutine_leak_fix',\n",
    "        'title': 'Detecção e Prevenção de Goroutine Leaks em Bots 24/7',\n",
    "        'category': 'concurrency',\n",
    "        'tags': ['goroutine', 'leak', 'pprof', 'context', 'channel'],\n",
    "        'content': '''Goroutines sem terminação adequada são a causa #1 de crash por OOM em bots Go após dias de uptime.\\nSempre passe context.Context com timeout para goroutines em loop. Monitore com /debug/pprof/goroutine.''\''\n",
    "    },\n",
    "    {\n",
    "        'id': 'go_bot_tcp_keepalive_socket',\n",
    "        'title': 'Tuning de Sockets TCP e KeepAlive para Jogos Online (Tibia/Baiak)',\n",
    "        'category': 'networking',\n",
    "        'tags': ['tcp', 'keepalive', 'socket', 'tibia', 'baiak', 'latency'],\n",
    "        'content': '''Configure net.Dialer com KeepAlive: 15s e SetNoDelay(true) no TCPConn para eliminar buffer lag nos pacotes de jogo.''\''\n",
    "    },\n",
    "    {\n",
    "        'id': 'go_bot_swap_tuning_vps_1gb',\n",
    "        'title': 'Configuração Ótima de Swappiness e ZRAM no Linux para Bots',\n",
    "        'category': 'sysadmin',\n",
    "        'tags': ['swap', 'swappiness', 'ram', 'vps', 'oracle'],\n",
    "        'content': '''Em VPS de 1GB RAM, reduza vm.swappiness para 10 no /etc/sysctl.conf para evitar lentidão de SSD nos bots de jogo.''\''\n",
    "    },\n",
    "    {\n",
    "        'id': 'go_bot_cloudflare_tunnel_proxy',\n",
    "        'title': 'Gerenciamento de Túneis Cloudflared em Go sem Consumo Excessivo de RAM',\n",
    "        'category': 'networking',\n",
    "        'tags': ['cloudflared', 'tunnel', 'proxy', 'cloudflare', 'ram'],\n",
    "        'content': '''Unifique todos os subdomínios em um único arquivo de configuração config.yml com regras de ingress para economizar 60MB de RAM.''\''\n",
    "    },\n",
    "    {\n",
    "        'id': 'go_bot_atomic_state_concurrency',\n",
    "        'title': 'Gerenciamento de Estado de Bots com sync/atomic sem Locks Bloqueantes',\n",
    "        'category': 'performance',\n",
    "        'tags': ['atomic', 'sync', 'mutex', 'lock-free', 'concurrency'],\n",
    "        'content': '''Use atomic.Int64 e atomic.Bool para contadores e flags de estado em loops rápidos de bots em vez de Mutex tradicional.''\''\n",
    "    },\n",
    "    {\n",
    "        'id': 'go_bot_packet_buffer_pooling',\n",
    "        'title': 'Reutilização de Buffers de Pacotes com sync.Pool',\n",
    "        'category': 'memory',\n",
    "        'tags': ['sync.pool', 'buffer', 'allocation', 'gc', 'bytes'],\n",
    "        'content': '''Reutilize buffers de rede usando sync.Pool para reduzir coletas de lixo do Garbage Collector em alta taxa de pacotes.''\''\n",
    "    }\n",
    "]\n",
    "\n",
    "chunks = list(KNOWLEDGE_SEEDS)\n",
    "topics = [\n",
    "    ('Huntera Idle Engine Optimization', 'huntera', 'idle,game,loop,timer,damage,cpu'),\n",
    "    ('Tibidle Multi-Account Connection Manager', 'tibidle', 'multi-client,accounts,session,proxy'),\n",
    "    ('Pokemon Sigma Bot Battle Routine', 'sigma', 'pokemon,battle,cooldown,skill,target'),\n",
    "    ('Leveling Idle 2D Auto-Farmer', 'leveling', 'farming,pathfinding,inventory,loot'),\n",
    "    ('PokeIdle.io Port 3006 Recovery Engine', 'pokeidle', 'port3006,crash,socket,systemd'),\n",
    "    ('KickMiner & TwitchMiner Stream Watcher', 'miners', 'kick,twitch,mining,points,websocket'),\n",
    "    ('Baiak Fleet Fleet-wide Coordination', 'baiak', 'fleet,coordination,guild,team,otbm')\n",
    "]\n",
    "for title, cat, tags in topics:\n",
    "    for var in range(1, 20):\n",
    "        chunks.append({\n",
    "            'id': f'{cat}_proc_{var}',\n",
    "            'title': f'{title} - Procedimento #{var}',\n",
    "            'category': cat,\n",
    "            'tags': [t.strip() for t in tags.split(',')] + [f'v{var}'],\n",
    "            'content': f'Procedimento técnico especializado para {title}. Engenharia de alta performance em Go, tratamento de exceções de rede e autocura autônoma no Linux.'\n",
    "        })\n",
    "\n",
    "print(f'Total de itens de conhecimento: {len(chunks)}')\n",
    "\n",
    "# Geração de Embeddings\n",
    "texts = [f\"{c['title']} | Tags: {','.join(c['tags'])} | {c['content']}\" for c in chunks]\n",
    "embeddings = model.encode(texts, batch_size=64, show_progress_bar=True, normalize_embeddings=True)\n",
    "for i, emb in enumerate(embeddings):\n",
    "    chunks[i]['vector'] = emb.tolist()\n",
    "\n",
    "# Exporta GOBRAIN1 binário\n",
    "bin_path = 'knowledge_brain.bin'\n",
    "with open(bin_path, 'wb') as f:\n",
    "    f.write(b'GOBRAIN1')\n",
    "    f.write(struct.pack('<I', 1))\n",
    "    f.write(struct.pack('<I', len(chunks)))\n",
    "    f.write(struct.pack('<H', dim))\n",
    "    for c in chunks:\n",
    "        for s in [c['id'], c['title'], c['category'], ','.join(c['tags']), c['content']]:\n",
    "            b = s.encode('utf-8')\n",
    "            f.write(struct.pack('<I', len(b)))\n",
    "            f.write(b)\n",
    "        vec = c['vector']\n",
    "        f.write(struct.pack('<H', len(vec)))\n",
    "        for val in vec:\n",
    "            f.write(struct.pack('<f', float(val)))\n",
    "\n",
    "size_kb = os.path.getsize(bin_path) / 1024\n",
    "print(f'🎉 Binário gerado com sucesso: {bin_path} ({size_kb:.1f} KB)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gera link direto de download no Kaggle\n",
    "from IPython.display import FileLink\n",
    "FileLink('knowledge_brain.bin')"
   ]
  }
 ],
